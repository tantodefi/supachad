<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- New supachad.com signups → Moshi yes/no card on the operator's phone, every 2 min.
     Install: cp to ~/Library/LaunchAgents/ && launchctl load -w <that path> -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.nemoclaw.chad-signup-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/r/.nemoclaw/source/scripts/openwebui/chad-signup-watch.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <!-- Each pass detaches a moshi-hook ask that waits up to 24h; without this launchd
       kills it the moment the 2-second pass exits. -->
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>/Users/r/.nemoclaw/openwebui/chad-signup-watch.log</string>
  <key>StandardErrorPath</key><string>/Users/r/.nemoclaw/openwebui/chad-signup-watch.err.log</string>
</dict>
</plist>
