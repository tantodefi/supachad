<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily copytruncate of host Chad logs over 20 MB (keeps one .1.gz).
     Install: cp to ~/Library/LaunchAgents/ && launchctl load -w <that path> -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.nemoclaw.chad-log-rotate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/r/.nemoclaw/source/scripts/openwebui/chad-log-rotate.sh</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/r/.nemoclaw/openwebui/chad-log-rotate.log</string>
  <key>StandardErrorPath</key><string>/Users/r/.nemoclaw/openwebui/chad-log-rotate.log</string>
</dict>
</plist>
