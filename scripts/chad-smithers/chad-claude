#
# chad-claude — launch Claude Code inside tmux so Moshi can follow it.
#
# Moshi routes approve/deny taps, Chat View and steering into an agent by its
# tmux pane (`moshi-hook context` → kind=tmux). A session started in a bare
# terminal reports kind=shell and its approvals degrade to "respond on <host>".
# This wrapper makes the routable launch the default:
#   - already inside tmux → exec claude as-is
#   - otherwise → new-or-attach a per-directory session on the DEFAULT socket
#     (the one Moshi's session picker scans), named claude-<dir>
#
# Usage: chad-claude [claude args...]

set -euo pipefail

if [ -n "${TMUX:-}" ]; then
  exec claude "$@"
fi

name="claude-$(basename "$PWD" | tr -c 'A-Za-z0-9_-' '-' | sed 's/-*$//')"
if tmux has-session -t "=$name" 2>/dev/null; then
  exec tmux attach-session -t "=$name"
fi
exec tmux new-session -s "$name" -c "$PWD" claude "$@"
